{
  "$comment": "GENERATED from packages/schemas (SCHEMA_VERSION 0.2.0)",
  "$defs": {
    "CNNOutput": {
      "additionalProperties": false,
      "properties": {
        "image_quality": {
          "$ref": "#/$defs/ImageQuality"
        },
        "model_version": {
          "description": "e.g. 'vision-effnetb0-v3' or a W&B artifact ref",
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "top_k": {
          "description": "Predictions sorted by confidence, highest first",
          "items": {
            "$ref": "#/$defs/ConditionPrediction"
          },
          "minItems": 1,
          "title": "Top K",
          "type": "array"
        }
      },
      "required": [
        "top_k",
        "image_quality",
        "model_version"
      ],
      "title": "CNNOutput",
      "type": "object"
    },
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ChatRole"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "ChatRole": {
      "enum": [
        "system",
        "user",
        "assistant"
      ],
      "title": "ChatRole",
      "type": "string"
    },
    "ConditionPrediction": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "description": "Condition label from the model's label set",
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "confidence": {
          "description": "Calibrated probability in [0, 1]",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "condition",
        "confidence"
      ],
      "title": "ConditionPrediction",
      "type": "object"
    },
    "DermiRequest": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For log correlation only",
          "title": "Case Id"
        },
        "cnn_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/CNNOutput"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latest classifier output for this case, if an image was provided"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        }
      },
      "required": [
        "messages"
      ],
      "title": "DermiRequest",
      "type": "object"
    },
    "DermiResponse": {
      "additionalProperties": false,
      "properties": {
        "escalate_to_clinician": {
          "default": false,
          "description": "True when the model/guardrails recommend seeing a professional",
          "title": "Escalate To Clinician",
          "type": "boolean"
        },
        "message": {
          "$ref": "#/$defs/ChatMessage"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "safety_flags": {
          "items": {
            "type": "string"
          },
          "title": "Safety Flags",
          "type": "array"
        }
      },
      "required": [
        "message",
        "model_version"
      ],
      "title": "DermiResponse",
      "type": "object"
    },
    "DermiStreamEvent": {
      "description": "One SSE event from the LLM endpoint: `status`*, `delta`*, then `done` or `error`.",
      "discriminator": {
        "mapping": {
          "delta": "#/$defs/TokenDelta",
          "done": "#/$defs/StreamDone",
          "error": "#/$defs/StreamError",
          "status": "#/$defs/StreamStatus"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StreamStatus"
        },
        {
          "$ref": "#/$defs/TokenDelta"
        },
        {
          "$ref": "#/$defs/StreamDone"
        },
        {
          "$ref": "#/$defs/StreamError"
        }
      ],
      "title": "DermiStreamEvent"
    },
    "ImageQuality": {
      "enum": [
        "good",
        "acceptable",
        "poor",
        "unusable"
      ],
      "title": "ImageQuality",
      "type": "string"
    },
    "StreamDone": {
      "additionalProperties": false,
      "description": "Final event: the complete message plus metadata. The web app persists this.",
      "properties": {
        "response": {
          "$ref": "#/$defs/DermiResponse"
        },
        "type": {
          "const": "done",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "response"
      ],
      "title": "StreamDone",
      "type": "object"
    },
    "StreamError": {
      "additionalProperties": false,
      "description": "Terminal error event. The stream closes after it.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "title": "StreamError",
      "type": "object"
    },
    "StreamStatus": {
      "additionalProperties": false,
      "description": "Progress for the UI, e.g. 'loading model' during a GPU cold start.",
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "status",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "StreamStatus",
      "type": "object"
    },
    "TokenDelta": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "type": {
          "const": "delta",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "title": "TokenDelta",
      "type": "object"
    },
    "VisionRequest": {
      "additionalProperties": false,
      "properties": {
        "image_url": {
          "description": "Short-lived Supabase Storage signed URL. The endpoint downloads the image itself.",
          "format": "uri",
          "minLength": 1,
          "title": "Image Url",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For log correlation",
          "title": "Request Id"
        }
      },
      "required": [
        "image_url"
      ],
      "title": "VisionRequest",
      "type": "object"
    },
    "VisionResult": {
      "additionalProperties": false,
      "properties": {
        "output": {
          "$ref": "#/$defs/CNNOutput"
        },
        "type": {
          "const": "result",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "output"
      ],
      "title": "VisionResult",
      "type": "object"
    },
    "VisionStreamEvent": {
      "description": "One SSE event from the vision endpoint: zero or more `status`, then `result` or `error`.",
      "discriminator": {
        "mapping": {
          "error": "#/$defs/StreamError",
          "result": "#/$defs/VisionResult",
          "status": "#/$defs/StreamStatus"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StreamStatus"
        },
        {
          "$ref": "#/$defs/VisionResult"
        },
        {
          "$ref": "#/$defs/StreamError"
        }
      ],
      "title": "VisionStreamEvent"
    }
  },
  "description": "Index of every contract. Only used to produce the bundle; never sent over the wire.",
  "properties": {
    "cnn_output": {
      "$ref": "#/$defs/CNNOutput"
    },
    "dermi_request": {
      "$ref": "#/$defs/DermiRequest"
    },
    "dermi_response": {
      "$ref": "#/$defs/DermiResponse"
    },
    "dermi_stream_event": {
      "$ref": "#/$defs/DermiStreamEvent"
    },
    "vision_request": {
      "$ref": "#/$defs/VisionRequest"
    },
    "vision_stream_event": {
      "$ref": "#/$defs/VisionStreamEvent"
    }
  },
  "required": [
    "vision_request",
    "vision_stream_event",
    "cnn_output",
    "dermi_request",
    "dermi_response",
    "dermi_stream_event"
  ],
  "title": "DermiAIContracts",
  "type": "object"
}

# ML / Python side. Copy to .env and fill in. .env is gitignored; NEVER commit real values.
# Web app env (Supabase, model endpoint URLs) lives in apps/web/.env.example.
# In GCP these come from Secret Manager (see infra/gcp/README.md), not from .env.

# ---- General
DERMIAI_ENV=local                 # local | dev | prod

# ---- GCP
GCP_PROJECT_ID=
GCP_REGION=europe-west2
GCS_DATA_BUCKET=gs://dermiai-data
GCS_ARTIFACTS_BUCKET=gs://dermiai-artifacts
# Local dev auth: prefer `gcloud auth application-default login` over key files.
# GOOGLE_APPLICATION_CREDENTIALS=

# ---- Experiment tracking (Weights & Biases)
WANDB_API_KEY=
WANDB_ENTITY=dermiai
WANDB_PROJECT=                    # leave empty: set per area from config (dermiai-llm / dermiai-vision)
# WANDB_MODE=offline              # uncomment to log locally without network

# ---- Hugging Face (gated base models, private model repo)
HF_TOKEN=

# ---- LLM pipeline (synthetic data generation / LLM-as-judge via a hosted model)
JUDGE_API_KEY=

# ---- Local model endpoints (when running `just vision-serve` / `just llm-serve`)
# Bearer token the endpoints require. Must match MODEL_ENDPOINT_TOKEN in apps/web/.env.local
MODEL_ENDPOINT_TOKEN=

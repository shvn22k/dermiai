# Copy to apps/web/.env.local for local dev (gitignored).
# In production these are set in the Vercel project settings (Production / Preview / Development).
# Only NEXT_PUBLIC_* values reach the browser. Everything else stays server-side.

# ---- Supabase (local values are printed by `npm run db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: bypasses Row Level Security. Use it only in API routes, and never import it into client code.
SUPABASE_SECRET_KEY=
SUPABASE_IMAGES_BUCKET=skin-images

# ---- Model endpoints (GCP, streaming SSE). See docs/architecture.md.
VISION_ENDPOINT_URL=http://localhost:8081
LLM_ENDPOINT_URL=http://localhost:8082
# bearer: send MODEL_ENDPOINT_TOKEN. gcp-oidc: Vercel OIDC -> GCP Workload Identity -> ID token (see ADR 0003)
MODEL_AUTH_MODE=bearer
MODEL_ENDPOINT_TOKEN=
CRON_SECRET=
